FROM node:20-alpine

ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_ALLOW_INSECURE_BACKEND=false
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_ALLOW_INSECURE_BACKEND=$NEXT_PUBLIC_ALLOW_INSECURE_BACKEND

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

RUN npm run build

EXPOSE 3000
CMD ["npm", "start"]
